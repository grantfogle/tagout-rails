<div class="dashboard-layout">
<div class="dashboard">
    <% if @draw_results.any? %>
        <div class="results-table-container">
            <table class="results-table consolidated-table">
                <thead>
                    <tr>
                        <th class="sticky-col sticky-col--code">Hunt Code</th>
                        <th class="sticky-col sticky-col--unit">Unit</th>
                        <th class="sticky-col sticky-col--status">Status</th>
                        <th class="choice-header">4th</th>
                        <th class="choice-header">3rd</th>
                        <th class="choice-header">2nd</th>
                        <% (0..@max_points).each do |pts| %>
                            <th class="point-header <%= 'point-header--highlight' if @filters[:points] == pts %>"><%= pts %></th>
                        <% end %>
                    </tr>
                </thead>
                <tbody id="draw-results">
                    <%= render partial: 'table_rows', locals: { draw_results: @draw_results, filters: @filters, max_points: @max_points } %>
                </tbody>
            </table>
            <% if @has_more %>
                <div class="load-more-container"
                    id="load-more-container"
                    data-controller="infinite-scroll"
                    data-pages="<%= @pages %>"
                    data-filters="<%= @filters.to_json %>">
                    <span class="load-more-container__label">Loading more…</span>
                </div>
            <% end %>
        </div>

        <div class="results-summary">
            <p>Showing <%= @showing_count %> of <%= @total_count %> results</p>
        </div>
    <% else %>
        <section class="empty-state">
            <p>No draw results found. Try adjusting your filters.</p>
        </section>
    <% end %>
</div>

<aside class="filter-sidebar filter-sidebar--open" data-controller="filter-sidebar" data-reflex-permanent id="filter-sidebar">
    <div class="filter-sidebar__header">
        <button type="button" class="filter-sidebar__menu" data-action="filter-sidebar#toggle" data-filter-sidebar-target="button" aria-expanded="true" aria-controls="filter-sidebar-body" aria-label="Toggle filters">
            <span class="filter-sidebar__menu-bar"></span>
            <span class="filter-sidebar__menu-bar"></span>
            <span class="filter-sidebar__menu-bar"></span>
        </button>
        <h2 class="filter-sidebar__title">Filters</h2>
    </div>
    <div class="filter-sidebar__body" id="filter-sidebar-body">
    <%= form_with url: dashboard_path, class: 'form form__inline', method: :get, scope: :filters, local: true do |f| %>
        <%= render "filter_field", f: f, field: :state, label: "State", options: [["Colorado", "CO"]], selected: "CO", blank: nil, disabled: true %>
        <%= render "filter_field", f: f, field: :species, label: "Species", options: HuntStat::SPECIES_OPTIONS, selected: @filters[:species], blank: "All Species" %>
        <%= render "filter_field", f: f, field: :sex, label: "Sex", options: HuntStat.sex_options_for_select, selected: @filters[:sex], blank: "All" %>
        <%= render "filter_field", f: f, field: :hunt_method, label: "Method", options: HuntStat::METHOD_OPTIONS, selected: @filters[:hunt_method], blank: "All Methods" %>
        <%= render "filter_field", f: f, field: :season, label: "Season", options: HuntStat::SEASON_OPTIONS, selected: @filters[:season], blank: "All Seasons" %>
        <%= render "filter_field", f: f, field: :resident, label: "Status", options: HuntStat::RESIDENT_OPTIONS, selected: @filters[:resident]&.to_s, blank: "All" %>

        <div class="form__field field-pair">
            <div class="field-pair__item">
                <%= f.label :points, "Pref. points" %>
                <%= f.number_field :points,
                    value: @filters[:points],
                    min: 0, max: 99, step: 1,
                    placeholder: "e.g. 5",
                    data: { reflex: "change->Dashboard#filter" } %>
            </div>
            <div class="field-pair__item">
                <%= f.label :odds, "Min odds %" %>
                <%= f.number_field :odds,
                    value: @filters[:odds],
                    min: 0, max: 100, step: 1,
                    placeholder: "0–100",
                    data: { reflex: "change->Dashboard#filter" } %>
            </div>
        </div>

        <div class="form__field unit-search" data-controller="unit-search">
            <label for="unit-search-input">Units</label>
            <div class="unit-search__row">
                <input type="text" id="unit-search-input" inputmode="numeric" autocomplete="off"
                    placeholder="Add a unit, e.g. 11"
                    data-unit-search-target="input"
                    data-action="keydown->unit-search#keydown">
                <button type="button" class="unit-search__add" data-action="unit-search#add">Add</button>
            </div>
            <ul class="unit-search__chips" data-unit-search-target="chips"></ul>
            <%= f.hidden_field :units, value: Array(@filters[:units]).join(","), data: { unit_search_target: "field" } %>
            <button type="button" class="unit-search__clear" data-action="unit-search#clear" data-unit-search-target="clear" hidden>Clear units</button>
        </div>
    <% end %>
    </div>
</aside>

<%= render "shared/feedback" %>
</div>
